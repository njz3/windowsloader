#: src/common/gameoptions.cpp:27
msgid "Caméra"
msgstr ""

#: src/common/gameoptions.cpp:29
msgid "Les photos des joueurs (le link de Daytona ne tient pas sans caméra). Auto : la caméra du PC, sinon l'image fixe. Image fixe : une caméra émulée qui montre l'image ci-dessous. Ou une caméra du PC par son nom (l'image fixe si elle ne s'ouvre pas)."
msgstr ""

#: src/common/gameoptions.cpp:31
msgid "Image fixe (JPG ou PNG)"
msgstr ""

#: src/common/gameoptions.cpp:32
msgid "Le chemin de l'image de la caméra émulée ; vide : une image noire."
msgstr ""

